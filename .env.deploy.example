# Copy to .env.deploy (gitignored) and fill in. Kept out of git: the origin IP
# is what the CDN in front of it exists to hide.
DEPLOY_SERVER=your.server.ip
DEPLOY_DIR=/root/fleetmon
DOMAIN=fleetmon.example.com
# CIDR of the docker network the reverse proxy shares with the hub.
FLEETMON_ALLOW=172.20.0.0/16
