# Copy to .env.deploy (gitignored) and fill in. Kept out of git: the origin IP
# is what the CDN in front of it exists to hide.
DEPLOY_SERVER=your.server.ip
DEPLOY_DIR=/root/fleetmon
DOMAIN=fleetmon.example.com
# Subnet for the hub's private docker network, which only the hub and the
# reverse proxy join. Also the hub's allowlist. Pick one outside docker's
# default pools (172.17-31.x, 192.168.x) so it cannot collide later.
FLEETMON_SUBNET=10.213.0.0/29
